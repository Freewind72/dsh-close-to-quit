{
  "name": "dsh-close-to-quit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Make the desktop window close button quit the app instead of hiding to the tray, as a toggle in Settings > General.",
  "license": "MIT",
  "author": "local",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "desktop",
    "tray",
    "close-button"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
